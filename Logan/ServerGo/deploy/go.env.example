# Documentation template only. Copy OUTSIDE the checkout, chmod 0600, edit privately.
# Raw Compose env_file syntax: literal values, no shell expansion, no surrounding quotes.
LOGAN_ENV=development
LOGAN_CONTEXT_PATH=/logan-web
LOGAN_TIMEZONE=Asia/Shanghai
LOGAN_EXIT_WAIT=60s
LOGAN_HTTP_READ_TIMEOUT=30s
LOGAN_HTTP_WRITE_TIMEOUT=30s
LOGAN_HTTP_IDLE_TIMEOUT=1m
LOGAN_HTTP_MAX_BODY_BYTES=33554432
# Foundation probe only until each switch is explicitly enabled and prerequisites verified.
LOGAN_DB_ENABLED=false
LOGAN_NATIVE_ENABLED=false
LOGAN_WEB_ENABLED=false
LOGAN_NATIVE_QUERY_ENABLED=false
LOGAN_MAINTENANCE_ENABLED=false
LOGAN_METRICS_ENABLED=true
LOGAN_MYSQL_DSN=
LOGAN_DB_MAX_OPEN=20
LOGAN_DB_MAX_IDLE=10
LOGAN_DB_CONN_MAX_LIFETIME=30m
LOGAN_DB_PING_TIMEOUT=5s
# Required for Native and Native Query: original raw UTF-8 values, each exactly 16 bytes.
LOGAN_NATIVE_AES_KEY=
LOGAN_NATIVE_AES_IV=
LOGAN_NATIVE_CONCURRENCY=1
LOGAN_NATIVE_MAX_FRAME_BYTES=33554432
LOGAN_NATIVE_TIMEOUT=30s
LOGAN_OSS_ENDPOINT=
LOGAN_OSS_REGION=
LOGAN_OSS_BUCKET=
LOGAN_OSS_PREFIX=logan-logs/
LOGAN_OSS_ACCESS_KEY_ID=
LOGAN_OSS_ACCESS_KEY_SECRET=
LOGAN_OSS_SESSION_TOKEN=
LOGAN_OSS_TIMEOUT=30s
LOGAN_OSS_PATH_STYLE=false
# RSA file path is fixed by Compose; mount web-rsa.pem in the private directory.
LOGAN_WEB_WORKERS=1
LOGAN_WEB_MAX_TASKS=200
LOGAN_WEB_TIMEOUT=30s
LOGAN_WEB_WAIT=5s
LOGAN_NATIVE_QUERY_WORKERS=1
LOGAN_NATIVE_QUERY_MAX_IDS=200
LOGAN_NATIVE_QUERY_MAX_LINE_BYTES=4194304
LOGAN_NATIVE_QUERY_MAX_RECORDS=100000
LOGAN_NATIVE_QUERY_MAX_PLAIN_BYTES=134217728
LOGAN_NATIVE_QUERY_MAX_STAGED_BYTES=268435456
LOGAN_NATIVE_QUERY_TIMEOUT=30s
LOGAN_NATIVE_QUERY_WAIT=5s

# Soft Go heap limit excludes tmpfs and non-Go RSS.
GOMAXPROCS=1
GOMEMLIMIT=384MiB
# Review values; maintenance remains disabled unless separately authorized.
LOGAN_RETENTION=168h
LOGAN_MAINTENANCE_INTERVAL=1m
LOGAN_MAINTENANCE_TIMEOUT=30s
LOGAN_MAINTENANCE_BATCH=100
LOGAN_ORPHAN_AGE=24h
