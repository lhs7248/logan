# Documentation only. Export values explicitly; the program does not auto-load this file.
LOGAN_ENV=development
LOGAN_HTTP_ADDRESS=:8080
LOGAN_CONTEXT_PATH=/logan-web
LOGAN_TIMEZONE=Asia/Shanghai
LOGAN_DB_ENABLED=false
LOGAN_DB_MAX_OPEN=20
LOGAN_DB_MAX_IDLE=10
LOGAN_HTTP_READ_TIMEOUT=30s
LOGAN_HTTP_WRITE_TIMEOUT=30s
LOGAN_HTTP_IDLE_TIMEOUT=1m
LOGAN_EXIT_WAIT=60s
# LOGAN_MYSQL_DSN is intentionally absent. Supply credentials via your local secret mechanism.

# Native routes require an enabled DB and all required secret/OSS settings.
LOGAN_NATIVE_ENABLED=false
LOGAN_NATIVE_CONCURRENCY=4
LOGAN_NATIVE_MAX_FRAME_BYTES=33554432
LOGAN_NATIVE_TIMEOUT=30s
LOGAN_OSS_PREFIX=logan-logs/
LOGAN_OSS_TIMEOUT=30s
LOGAN_OSS_PATH_STYLE=false
# Supply LOGAN_NATIVE_AES_KEY, LOGAN_NATIVE_AES_IV via secret management (16 raw bytes each).
# Supply LOGAN_OSS_ENDPOINT, LOGAN_OSS_REGION, LOGAN_OSS_BUCKET.
# Supply LOGAN_OSS_ACCESS_KEY_ID, LOGAN_OSS_ACCESS_KEY_SECRET and optional LOGAN_OSS_SESSION_TOKEN.
# LOGAN_NATIVE_TEMP_DIR defaults to the system temporary directory.

# Apply migrations/001_web_processing.sql explicitly before enabling Web routes.
LOGAN_WEB_ENABLED=false
LOGAN_WEB_WORKERS=4
LOGAN_WEB_MAX_TASKS=200
LOGAN_WEB_TIMEOUT=30s
LOGAN_WEB_WAIT=5s
# LOGAN_WEB_RSA_PRIVATE_KEY_FILE must point to the mounted matching RSA private key.
# Historical sub-1024-bit keys need explicit runtime compatibility: see docs/web.md.

# Native query/parse routes require the shared processing migration and native OSS setup.
LOGAN_NATIVE_QUERY_ENABLED=false
LOGAN_NATIVE_QUERY_WORKERS=4
LOGAN_NATIVE_QUERY_MAX_IDS=200
LOGAN_NATIVE_QUERY_MAX_PLAIN_BYTES=134217728
LOGAN_NATIVE_QUERY_MAX_STAGED_BYTES=268435456
LOGAN_NATIVE_QUERY_MAX_LINE_BYTES=4194304
LOGAN_NATIVE_QUERY_MAX_RECORDS=100000
LOGAN_NATIVE_QUERY_TIMEOUT=30s
LOGAN_NATIVE_QUERY_WAIT=5s

# Apply migrations/002_maintenance.sql explicitly; Native DB/OSS setup required.
LOGAN_MAINTENANCE_ENABLED=false
LOGAN_RETENTION=168h
LOGAN_MAINTENANCE_INTERVAL=1m
LOGAN_MAINTENANCE_TIMEOUT=30s
LOGAN_MAINTENANCE_BATCH=100
LOGAN_ORPHAN_AGE=24h
LOGAN_METRICS_ENABLED=false
